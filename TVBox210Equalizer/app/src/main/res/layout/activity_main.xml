<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV BOX 210 Equalizer"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spreman"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp"/>

        <Button
            android:layout_width="260dp"
            android:layout_height="64dp"
            android:text="UKLJUČI"
            android:onClick="toggle"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESETI"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:layout_width="130dp" android:layout_height="58dp" android:text="FLAT" android:onClick="presetFlat" android:focusable="true"/>
            <Button android:layout_width="130dp" android:layout_height="58dp" android:text="BASS" android:onClick="presetBass" android:focusable="true"/>
            <Button android:layout_width="130dp" android:layout_height="58dp" android:text="VOICE" android:onClick="presetVoice" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:layout_width="160dp" android:layout_height="58dp" android:text="MOVIE" android:onClick="presetMovie" android:focusable="true"/>
            <Button android:layout_width="160dp" android:layout_height="58dp" android:text="MUSIC" android:onClick="presetMusic" android:focusable="true"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bass Boost" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_marginTop="18dp"/>
        <SeekBar android:id="@+id/bass" android:layout_width="600dp" android:layout_height="wrap_content" android:focusable="true"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Virtualizer" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_marginTop="14dp"/>
        <SeekBar android:id="@+id/virtualizer" android:layout_width="600dp" android:layout_height="wrap_content" android:focusable="true"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loudness" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_marginTop="14dp"/>
        <SeekBar android:id="@+id/loudness" android:layout_width="600dp" android:layout_height="wrap_content" android:focusable="true"/>
    </LinearLayout>
</ScrollView>
