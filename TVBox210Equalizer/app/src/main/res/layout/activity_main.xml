<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV BOX 210 EQUALIZER"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spreman"
            android:textSize="17sp"
            android:textColor="#E0E0E0"
            android:gravity="center"
            android:layout_marginBottom="18dp"/>

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="400dp"
            android:layout_height="72dp"
            android:text="UKLJUČI EKVILAJZER"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/eq_button_text_selector"
            android:background="@drawable/eq_button_selector"
            android:onClick="toggle"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESETI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:layout_width="135dp"
                android:layout_height="64dp"
                android:layout_margin="5dp"
                android:text="BAS +"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/eq_button_text_selector"
                android:background="@drawable/eq_button_selector"
                android:onClick="presetBass"
                android:focusable="true"/>

            <Button
                android:layout_width="135dp"
                android:layout_height="64dp"
                android:layout_margin="5dp"
                android:text="MUZIKA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/eq_button_text_selector"
                android:background="@drawable/eq_button_selector"
                android:onClick="presetMusic"
                android:focusable="true"/>

            <Button
                android:layout_width="135dp"
                android:layout_height="64dp"
                android:layout_margin="5dp"
                android:text="FILM"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/eq_button_text_selector"
                android:background="@drawable/eq_button_selector"
                android:onClick="presetMovie"
                android:focusable="true"/>

            <Button
                android:layout_width="135dp"
                android:layout_height="64dp"
                android:layout_margin="5dp"
                android:text="GOVOR"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/eq_button_text_selector"
                android:background="@drawable/eq_button_selector"
                android:onClick="presetVoice"
                android:focusable="true"/>

            <Button
                android:layout_width="135dp"
                android:layout_height="64dp"
                android:layout_margin="5dp"
                android:text="RAVNO"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/eq_button_text_selector"
                android:background="@drawable/eq_button_selector"
                android:onClick="presetFlat"
                android:focusable="true"/>
        </LinearLayout>

        <TextView android:id="@+id/label0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 Hz" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:layout_marginTop="22dp"/>
        <SeekBar android:id="@+id/band0" android:layout_width="680dp" android:layout_height="wrap_content" android:focusable="true"/>
        <TextView android:id="@+id/label1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="230 Hz" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:layout_marginTop="10dp"/>
        <SeekBar android:id="@+id/band1" android:layout_width="680dp" android:layout_height="wrap_content" android:focusable="true"/>
        <TextView android:id="@+id/label2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="910 Hz" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:layout_marginTop="10dp"/>
        <SeekBar android:id="@+id/band2" android:layout_width="680dp" android:layout_height="wrap_content" android:focusable="true"/>
        <TextView android:id="@+id/label3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3.6 kHz" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:layout_marginTop="10dp"/>
        <SeekBar android:id="@+id/band3" android:layout_width="680dp" android:layout_height="wrap_content" android:focusable="true"/>
        <TextView android:id="@+id/label4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14 kHz" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:layout_marginTop="10dp"/>
        <SeekBar android:id="@+id/band4" android:layout_width="680dp" android:layout_height="wrap_content" android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Miš ili daljinski: fokusirano dugme menja boju."
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"/>
    </LinearLayout>
</ScrollView>
